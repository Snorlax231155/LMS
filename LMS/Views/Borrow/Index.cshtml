@model IEnumerable<LMS.Models.Book>
@{
    ViewData["Title"] = "Borrow a Book";
}

<div class="container mt-4">
    <h2>Borrow a Book</h2>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Published</th>
                <th>Available</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublishedDate.ToShortDateString()</td>
                    <td>@(book.IsAvailable ? "Yes" : "No")</td>
                    <td>
                        @if (book.IsAvailable)
                        {
                            <a asp-action="Create" asp-controller="Borrow" asp-route-bookId="@book.BookId" class="btn btn-primary btn-sm">Borrow</a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm" disabled>Unavailable</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
