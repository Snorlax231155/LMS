@model IEnumerable<LMS.Models.StudentModel>
@{
    ViewData["Title"] = "Students";
}
<a class="btn btn-primary mb-3" asp-action="Create">Add New Student</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>StudentId</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach(var s in Model) {
        <tr>
            <td>@s.StudentId</td>
            <td>@s.StudentName</td>
            <td>@s.Email</td>
            <td>@s.Phone</td>
            <td>
                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@s.StudentId">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@s.StudentId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
