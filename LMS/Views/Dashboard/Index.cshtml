@model LMS.Models.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<h2>Admin Dashboard</h2>
<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <h5>Total Books</h5>
            <p class="display-6">@Model.TotalBooks</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <h5>Total Students</h5>
            <p class="display-6">@Model.TotalStudents</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <h5>Currently Borrowed</h5>
            <p class="display-6">@Model.CurrentBorrowed</p>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card p-3">
            <h6>Total Borrowings (all time)</h6>
            <p>@Model.TotalBorrowings</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3">
            <h6>Total Librarians</h6>
            <p>@Model.TotalLibrarians</p>
        </div>
    </div>
</div>
