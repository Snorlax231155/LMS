@model IEnumerable<LMS.Models.Book>
@{
    ViewData["Title"] = "Books List";
}

<h2>@ViewData["Title"]</h2>

<div class="row mb-3">
    <div class="col-md-6">
        <form method="get" asp-action="Index" class="d-flex" role="search">
            <input name="searchString" value="@ViewBag.SearchString" class="form-control me-2" placeholder="Search by title, author or ISBN" />
            <button class="btn btn-outline-secondary" type="submit">Search</button>
        </form>
    </div>
    <div class="col-md-6 text-end">
        <a class="btn btn-primary" asp-action="Create">Add New Book</a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>ISBN</th>
            <th>Published</th>
            <th>Available</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Author</td>
            <td>@item.ISBN</td>
            <td>@item.PublishedDate.ToString("yyyy-MM-dd")</td>
            <td>@(item.IsAvailable ? "Yes" : "No")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@{
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var search = ViewBag.SearchString as string;
}

<nav aria-label="Page navigation">
    <ul class="pagination">
        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@search">Previous</a>
        </li>
        @for (var p = 1; p <= totalPages; p++)
        {
            <li class="page-item @(p == currentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchString="@search">@p</a>
            </li>
        }
        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@search">Next</a>
        </li>
    </ul>
</nav>
