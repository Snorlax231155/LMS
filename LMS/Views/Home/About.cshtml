@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-4">
    <h1>About Us</h1>
    <p>Welcome to the Library Management System (LMS). Our mission is to provide easy access
       to a curated collection of books, magazines, and newspapers for learning and enjoyment.</p>

    <h4>What we offer</h4>
    <ul>
        <li>A searchable catalogue of books with availability information.</li>
        <li>Borrow and return flow to manage loans.</li>
        <li>Administrative tools for librarians to manage resources.</li>
    </ul>

    <h4>Our values</h4>
    <p>We strive to make knowledge accessible, encourage reading, and support our community.</p>
</div>
