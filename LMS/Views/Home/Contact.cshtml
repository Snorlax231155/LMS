@{
    ViewData["Title"] = "Contact Us";
}

<div class="container mt-4">
    <h1>Contact Us</h1>
    <p>If you have questions, feedback or need assistance, reach out to us:</p>

    <ul class="list-unstyled">
        <li><strong>Email:</strong> support@lms.example.com</li>
        <li><strong>Phone:</strong> +1 (555) 123-4567</li>
        <li><strong>Address:</strong> 123 Library Street, Knowledge City</li>
    </ul>

    <h4>Send us a message</h4>
    <form method="post" asp-controller="Home" asp-action="Contact">
        <div class="mb-3">
            <label for="name" class="form-label">Your name</label>
            <input id="name" name="name" class="form-control" />
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input id="email" name="email" class="form-control" />
        </div>
        <div class="mb-3">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" class="form-control" rows="4"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send</button>
    </form>
</div>
