@model IEnumerable<LMS.Models.Book>
@{
    ViewData["Title"] = "Welcome to LMS";
}

<div class="jumbotron p-5 rounded bg-light mb-4">
    <div class="container">
        <h1 class="display-4">Welcome to the Library Management System</h1>
        <p class="lead">Browse, borrow and manage books easily. Discover featured titles below or search the full catalog.</p>
        <p>
            <a class="btn btn-primary btn-lg" asp-controller="Books" asp-action="Index">View All Books</a>
            <a class="btn btn-outline-secondary btn-lg ms-2" asp-controller="Borrow" asp-action="Index">Borrow a Book</a>
        </p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center p-3">
            <h5>Total Books</h5>
            <p class="display-6">@ViewBag.TotalBooks</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <h5>Total Students</h5>
            <p class="display-6">@ViewBag.TotalStudents</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <h5>Currently Borrowed</h5>
            <p class="display-6">@ViewBag.CurrentBorrowed</p>
        </div>
    </div>
</div>

<h3>Featured Titles</h3>
<div class="row">
    @foreach (var book in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@book.Title</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@book.Author</h6>
                    <p class="card-text mt-auto"><small>Published: @book.PublishedDate.ToShortDateString()</small></p>
                </div>
                <div class="card-footer text-end">
                    @if (book.IsAvailable)
                    {
                        <a asp-controller="Borrow" asp-action="Create" asp-route-bookId="@book.BookId" class="btn btn-sm btn-primary">Borrow</a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm" disabled>Unavailable</button>
                    }
                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-link">Details</a>
                </div>
            </div>
        </div>
    }
</div>

<hr />

<div class="text-center mt-4">
    <p class="text-muted">Manage your library with ease. If you are an admin, log in to add or edit resources.</p>
</div>
